{
  "settings": {
    "pull_to_refresh_enabled": true
  },
  "rules": [
    {
      "patterns": ["^/$"],
      "properties": {
        "view_controller": "treino",
        "pull_to_refresh_enabled": true,
        "presentation": "replace"
      }
    },
    {
      "patterns": ["^/workout_plans/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    },
    {
      "patterns": ["^/workout_plans/[0-9]+/routines/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    },
    {
      "patterns": ["^/session/new$"],
      "properties": {
        "pull_to_refresh_enabled": false,
        "presentation": "replace"
      }
    },
    {
      "patterns": ["^/session$"],
      "properties": {
        "view_controller": "logout"
      }
    },
    {
      "patterns": ["^/clients$"],
      "properties": {
        "view_controller": "clients",
        "pull_to_refresh_enabled": true,
        "presentation": "replace"
      }
    },
    {
      "patterns": ["^/clients/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    },
    {
      "patterns": ["^/exercises$"],
      "properties": {
        "view_controller": "exercises",
        "pull_to_refresh_enabled": true,
        "presentation": "replace"
      }
    },
    {
      "patterns": ["^/exercises/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    }
  ]
}