{
  "settings": {},
  "rules": [
    {
      "patterns": [
        "^/$",
        "^/clients$",
        "^/conversations$",
        "^/exercises$",
        "^/meal_plans$",
        "^/compounds_plans$",
        "^/anthropometric_assessments$",
        "^/anthropometric_assessments/comparison$",
        "^/settings$",
        "^/settings/profile$"
      ],
      "properties": {
        "presentation": "replace"
      }
