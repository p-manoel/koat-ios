{
  "settings": {
    "pull_to_refresh_enabled": true
  },
  "rules": [
    {
      "patterns": ["^/$"],
      "properties": {
        "view_controller": "treino",
        "pull_to_refresh_enabled": true,
        "presentation": "replace",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": ["^/workout_plans/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": ["^/workout_plans/[0-9]+/routines/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push",
        "navigation_bar_hidden": false
      }
    },
    {
      "patterns": ["^/workout_plans/[0-9]+/routines/[0-9]+/routine_exercises/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push",
        "navigation_bar_hidden": false
      }
    },
    {
      "patterns": ["^/session/new$"],
      "properties": {
        "pull_to_refresh_enabled": false,
        "presentation": "replace",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": ["^/session$"],
      "properties": {
        "view_controller": "logout"
      }
    },
    {
      "patterns": ["^/clients$"],
      "properties": {
        "view_controller": "clients",
        "pull_to_refresh_enabled": true,
        "presentation": "replace",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": ["^/clients/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    },
    {
      "patterns": ["^/exercises$"],
      "properties": {
        "view_controller": "exercises",
        "pull_to_refresh_enabled": true,
        "presentation": "replace",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": ["^/exercises/[0-9]+$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "push"
      }
    },
    {
      "patterns": ["^/settings/profile$"],
      "properties": {
        "pull_to_refresh_enabled": true,
        "presentation": "replace",
        "navigation_bar_hidden": true
      }
    },
    {
      "patterns": [
        "^/exercises/new$",
        "^/exercises/[0-9]+/edit$",
        "^/clients/new$",
        "^/clients/[0-9]+/edit$",
        "^/workout_plans/new$",
        "^/workout_plans/[0-9]+/edit$",
        "^/routines/new$",
        "^/routines/[0-9]+/edit$",
        "^/settings/profile/edit$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}